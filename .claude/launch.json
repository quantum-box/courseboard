{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "courseboard-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "desktop"],
      "port": 5173
    },
    {
      "name": "courseboard-desktop-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_COURSEBOARD_AUTH_MODE=development",
        "VITE_COURSEBOARD_API_BEARER=dev-local-token",
        "npm",
        "--prefix",
        "desktop",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
