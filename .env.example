# Local development overrides, loaded automatically by `cargo run`.
# Copy to `.env` and adjust. Do NOT put production secrets here — real
# credentials are injected via deployment secrets / environment variables.

# dev-only static bearer verifier (skips OIDC). Local development only.
COURSEBOARD_DEV_BEARER_TOKEN=local-dev-token

# Local database. MySQL 互換のみ（実体は TiDB）。sqlite:// を渡すと起動時に
# "DATABASE_URL must be a valid MySQL URL" で落ちる。
# 手元の TiDB は次で立つ:
#   docker run --rm -d -p 4000:4000 --name courseboard-tidb pingcap/tidb:v8.5.7
DATABASE_URL=mysql://root@127.0.0.1:4000/courseboard

# Public UI base URL used in generated payment links.
COURSEBOARD_PUBLIC_UI_BASE_URL=http://127.0.0.1:8080/ui/index.html

# Field API integration (admin caddie/dispatch UI, /field-api proxy, and
# /v1/course/* write-through gateways).
# Local course-api always connects to Field. When unset, defaults to production:
TACHYON_FIELD_API_URL=https://tachyon-field-api.txcloud.app
#
# Preferred local start (mise; sources .env.browser-pkce with prod Field).
# Entrypoints: desktop/scripts/configure.mjs + desktop/scripts/dev.sh
#   mise run courseboard:pkce-env
#   mise run courseboard:api          # :8080 OIDC inbound + Field outbound
#   mise run courseboard:vite         # :5173 password login
# Field CLI bearer expires ~1h — refresh without inventing Field Tachyon auth:
#   mise run courseboard:api-refresh  # pkce-env; bacon re-reads .env.browser-pkce
# CLI JWT shortcut (no login UI):
#   mise run courseboard:field-env && mise run courseboard:field-api
# Test-only opt-out (not used by mise API tasks): TACHYON_FIELD_API_URL=empty://local
# Browser-pkce: Tachyon access-token issuer (not Cognito).
# OIDC_ISSUER_URL=https://api.n1.tachy.one
# EXPECTED_AUDIENCE=<courseboard-local-pkce public client id>

# Preferred Field API auth: Course Board obtains tokens via OAuth2
# client-credentials. Keep real secrets in deployment secrets.
# TACHYON_FIELD_API_TOKEN_URL=https://app.n1.tachy.one/oauth2/token
# TACHYON_FIELD_API_CLIENT_ID=<client-id>
# TACHYON_FIELD_API_CLIENT_SECRET=<client-secret>
# TACHYON_FIELD_API_SCOPE=<scope>
# TACHYON_FIELD_API_AUDIENCE=<audience>

# Static bearer fallback for tests or gateway-fronted deployments.
# Local browser-pkce + prod Field: set to a Cognito access token (e.g. from
# `tachyon auth login` / mise run courseboard:pkce-env). Inbound browser JWT
# is still verified via OIDC; this value is used only for outbound Field
# Authorization.
# TACHYON_FIELD_API_BEARER_TOKEN=<field-api-access-token>
