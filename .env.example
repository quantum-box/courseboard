# Local development overrides, loaded automatically by `cargo run`.
# Copy to `.env` and adjust. Do NOT put production secrets here — real
# credentials are injected via deployment secrets / environment variables.

# dev-only static bearer verifier (skips OIDC). Local development only.
COURSEBOARD_DEV_BEARER_TOKEN=local-dev-token

# Local SQLite database.
DATABASE_URL=sqlite:///tmp/courseboard-local.db

# Public UI base URL used in generated payment links.
COURSEBOARD_PUBLIC_UI_BASE_URL=http://127.0.0.1:8080/ui/index.html

# Field API integration (admin caddie/dispatch UI and cancellation fees).
# Leave unset to run without the Field-backed features.
# TACHYON_FIELD_API_URL=http://127.0.0.1:3001/
# TACHYON_FIELD_API_BEARER_TOKEN=<field-api-access-token>
