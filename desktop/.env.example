# Local development only. Remove these three values when using the real Web session.
VITE_COURSEBOARD_AUTH_MODE=development
VITE_COURSEBOARD_API_BEARER=local-dev-token
VITE_COURSEBOARD_TENANT_ID=courseboard_id
# When AUTH_MODE=development, Field / course-api fixtures and the course-map cart
# mock are ON by default so golf screens stay browsable without Rust / Field.
# Happy path: leave unset or true. Live local against :8080 course-api:
# VITE_COURSEBOARD_MOCK_DATA=false
# (course-api without TACHYON_FIELD_API_URL returns empty list GETs.)
#
# Live local → production Field (real JWT + tn_… tenant):
#   npm run field:env
# That writes a gitignored .env.local with MOCK_DATA=false, a Tachyon access
# token as VITE_COURSEBOARD_API_BEARER, and TENANT_ID/OPERATOR_ID as tn_….
# Prod Field rejects local demo ids like "courseboard_id" (must start with tn_).

# Shared runtime context (local mock/demo only — ignored when MOCK_DATA=false).
# VITE_COURSEBOARD_MOCK_DATA=true
# VITE_COURSEBOARD_TENANT_NAME=CourseBoard Demo
# VITE_COURSEBOARD_TENANT_SLUG=courseboard
VITE_COURSEBOARD_PLATFORM_ID=tn_01hjjn348rn3t49zz6hvmfq67p
VITE_COURSEBOARD_OPERATOR_ID=courseboard_id
VITE_COURSEBOARD_MODE=production
# VITE_COURSEBOARD_EXTERNAL_HOSTS=payments.example.com
# Public-payment-only Rust bundle: redirect operator routes to the Auth.js host.
# VITE_COURSEBOARD_OPERATOR_WEB_URL=https://courseboard.txcloud.app/courseboard-ui/index.html

# Preferred real-user login (no Auth.js / no Cognito Hosted UI):
#   npm run pkce:env
# That writes browser-pkce + public client id, and course-api OIDC env
# (.env.browser-pkce). Login uses Tachyon /oauth2/login + JSON PKCE
# (same as platform-ui). Nominal redirect URI that must be registered:
#   http://127.0.0.1:5173/oauth/callback
# Do not mix with AUTH_MODE=development / API_BEARER — the UI fails visibly
# instead of silently becoming "Local operator".
# VITE_COURSEBOARD_AUTH_MODE=browser-pkce
# VITE_COURSEBOARD_BROWSER_CLIENT_ID=<public-client-id>
# VITE_COURSEBOARD_BROWSER_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback
# VITE_COURSEBOARD_BROWSER_LOGIN_ENDPOINT=https://api.n1.tachy.one/oauth2/login
# VITE_COURSEBOARD_BROWSER_AUTHORIZATION_ENDPOINT=https://api.n1.tachy.one/oauth2/authorize
# VITE_COURSEBOARD_BROWSER_TOKEN_ENDPOINT=https://api.n1.tachy.one/oauth2/token
# VITE_COURSEBOARD_BROWSER_PROFILE_ENDPOINT=https://api.n1.tachy.one/v1/me
# VITE_COURSEBOARD_MOCK_DATA=false
#
# CLI JWT shortcut (no password login UI; exclusive with browser-pkce):
#   npm run field:env
# VITE_COURSEBOARD_AUTH_MODE=development + VITE_COURSEBOARD_API_BEARER
# (removes VITE_COURSEBOARD_BROWSER_* so Login cannot fall back to Local operator)
#
# Optional Auth.js path (not recommended locally):
#   npm run auth:env
# VITE_COURSEBOARD_AUTH_MODE=web-session

# Native production auth (Tauri only). Do not add a client secret. Keep
# DEEP_LINK_READY unset until the public client and profile BFF are deployed.
# The Tauri bundle registers courseboard://oauth/callback on desktop/iOS/Android.
# VITE_COURSEBOARD_API_BASE_URL=https://courseboard.txcloud.app
# VITE_COURSEBOARD_NATIVE_AUTHORIZATION_ENDPOINT=https://api.n1.tachy.one/oauth2/authorize
# VITE_COURSEBOARD_NATIVE_TOKEN_ENDPOINT=https://api.n1.tachy.one/oauth2/token
# VITE_COURSEBOARD_NATIVE_PROFILE_ENDPOINT=https://courseboard.txcloud.app/api/auth/native-profile
# VITE_COURSEBOARD_NATIVE_CLIENT_ID=courseboard-native-public-client-id
# VITE_COURSEBOARD_NATIVE_REDIRECT_URI=courseboard://oauth/callback
# VITE_COURSEBOARD_NATIVE_SCOPES=openid profile email
# VITE_COURSEBOARD_NATIVE_DEEP_LINK_READY=true
