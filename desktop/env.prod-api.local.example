# Copy/reference only. Real overlay is written by:
#   cd desktop && npm run prod-api:pkce-env   # Cognito Hosted UI (real user)
#   cd desktop && npm run prod-api:env        # CLI JWT (Local operator)
# → desktop/.env.prod-api.local (gitignored)
#
# Start Vite with the overlay (does not modify .env.local):
#   mise run courseboard:vite-prod-api
#   # or: cd desktop && npm run prod-api:vite
#
# Architecture: browser stays same-origin; Vite proxies to production course-api.
# Do NOT set VITE_COURSEBOARD_API_BASE_URL to the prod host in Web — api.ts
# requires same-origin for browser builds.

# --- Preferred: Cognito Hosted UI (real user; not Local operator) ---
VITE_COURSEBOARD_AUTH_MODE=cognito-pkce
VITE_COURSEBOARD_BROWSER_CLIENT_ID=<public client from prod-api:pkce-env>
VITE_COURSEBOARD_BROWSER_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback
VITE_COURSEBOARD_BROWSER_AUTHORIZATION_ENDPOINT=https://auth-pool.n1.tachy.one/oauth2/authorize
VITE_COURSEBOARD_BROWSER_TOKEN_ENDPOINT=https://auth-pool.n1.tachy.one/oauth2/token
VITE_COURSEBOARD_BROWSER_PROFILE_ENDPOINT=https://api.n1.tachy.one/v1/me
VITE_COURSEBOARD_BROWSER_SCOPES=openid profile email
VITE_COURSEBOARD_BROWSER_LOGIN_ENDPOINT=
VITE_COURSEBOARD_API_BEARER=
VITE_COURSEBOARD_TENANT_ID=tn_…
VITE_COURSEBOARD_OPERATOR_ID=tn_…
VITE_COURSEBOARD_MOCK_DATA=false
VITE_COURSEBOARD_MODE=production
VITE_DEV_API_PROXY_TARGET=https://courseboard-api.txcloud.app

# --- Alternative: CLI JWT shortcut (shows "Local operator") ---
# VITE_COURSEBOARD_AUTH_MODE=development
# VITE_COURSEBOARD_API_BEARER=<Tachyon CLI Cognito access token>
# (and clear VITE_COURSEBOARD_BROWSER_* with empty KEY= overrides)

# Auth caveats:
# - Prod courseboard-api OIDC issuer is Cognito (not api.n1.tachy.one).
# - Tachyon JSON browser-pkce tokens (iss=api.n1.tachy.one) get 401 from prod.
# - Append the public client id to courseboard-api EXPECTED_CLIENT_ID and redeploy.
# - Field upstream on that deploy is production Field (via course-api), not local.
