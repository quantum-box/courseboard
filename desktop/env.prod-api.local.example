# Copy/reference only. Real overlay is written by:
#   cd desktop && npm run prod-api:pkce-env   # React password login (real user)
#   cd desktop && npm run prod-api:env        # CLI JWT (Local operator)
# → desktop/.env.prod-api.local (gitignored)
#
# Start Vite with the overlay (does not modify .env.local):
#   mise run courseboard:vite-prod-api
#   # or: cd desktop && npm run prod-api:vite
#
# Architecture: React sends Tachyon JSON PKCE bearer tokens directly to courseboard-api.
# The API allows the local Vite and production Course Board origins with CORS.

# --- Preferred: platform-ui style password login (real user) ---
VITE_COURSEBOARD_AUTH_MODE=browser-pkce
VITE_COURSEBOARD_BROWSER_CLIENT_ID=<public client from prod-api:pkce-env>
VITE_COURSEBOARD_BROWSER_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback
VITE_COURSEBOARD_BROWSER_LOGIN_ENDPOINT=https://api.n1.tachy.one/oauth2/login
VITE_COURSEBOARD_BROWSER_AUTHORIZATION_ENDPOINT=https://api.n1.tachy.one/oauth2/authorize
VITE_COURSEBOARD_BROWSER_TOKEN_ENDPOINT=https://api.n1.tachy.one/oauth2/token
VITE_COURSEBOARD_BROWSER_PROFILE_ENDPOINT=https://courseboard-api.txcloud.app/v1/me
VITE_COURSEBOARD_BROWSER_SCOPES=openid profile email
VITE_COURSEBOARD_API_BEARER=
VITE_COURSEBOARD_TENANT_ID=tn_…
VITE_COURSEBOARD_OPERATOR_ID=tn_…
VITE_COURSEBOARD_MOCK_DATA=false
VITE_COURSEBOARD_MODE=production
VITE_COURSEBOARD_API_BASE_URL=https://courseboard-api.txcloud.app
VITE_DEV_API_PROXY_TARGET=

# --- Alternative: CLI JWT shortcut (shows "Local operator") ---
# VITE_COURSEBOARD_AUTH_MODE=development
# VITE_COURSEBOARD_API_BEARER=<Tachyon CLI Cognito access token>
# (and clear VITE_COURSEBOARD_BROWSER_* with empty KEY= overrides)

# Auth caveats:
# - Prod courseboard-api OIDC issuer must be https://api.n1.tachy.one.
# - EXPECTED_AUDIENCE and EXPECTED_CLIENT_ID must match the public client id.
# - Cognito Hosted UI is not used.
# - Field upstream on that deploy is production Field (via course-api), not local.
