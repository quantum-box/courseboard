{
  "name": "tachyon-field-admin-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3001",
    "build": "vinext build && rm -rf .vercel/output/static && mkdir -p .vercel/output && cp -R dist/client .vercel/output/static",
    "start": "vinext start",
    "next:lint": "next lint",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "format:write": "biome format --write ./src",
    "test": "vitest run --config ./vitest.config.ts",
    "codegen": "pnpm run codegen:graphql && pnpm run codegen:rest",
    "codegen:graphql": "graphql-codegen && node ./scripts/patch-graphql-request-import.mjs",
    "codegen:rest": "rm -rf src/gen/api/ && openapi2aspida -i=../api/tachyon-field.openapi.yaml -o=src/gen/api",
    "dev:ts": "pnpm run dev & pnpm run ts:watch",
    "ts": "tsc --noEmit --incremental",
    "ts:watch": "pnpm run ts --watch",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:smoke": "playwright test -c playwright.config.ts e2e/admin-smoke.spec.ts --project=chromium",
    "e2e:ci": "playwright test -c playwright.config.ts --project=chromium",
    "dev:next": "next dev -H 0.0.0.0 -p 3001",
    "build:next": "next build",
    "start:next": "next start"
  },
  "dependencies": {
    "@aspida/fetch": "^1.14.0",
    "@auth/core": "0.41.2",
    "@aws-sdk/client-cognito-identity-provider": "^3.654.0",
    "@biomejs/biome": "^1.9.0",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.1",
    "@graphql-codegen/cli": "^4.0.1",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-graphql-request": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@hookform/resolvers": "^3.3.4",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-form": "^0.0.3",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@sentry/nextjs": "^10.50.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@tachyon-sdk/agent": "^0.3.0",
    "@tachyon-sdk/agent-chat": "^0.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@urql/next": "^1.1.3",
    "aspida": "^1.14.0",
    "autoprefixer": "10.4.15",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "graphql": "^16.7.1",
    "graphql-codegen-typescript-validation-schema": "^0.11.1",
    "graphql-tag": "^2.12.6",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.378.0",
    "next": "^14.2.7",
    "next-auth": "^5.0.0-beta.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "postcss": "8.4.29",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.51.4",
    "recharts": "^2.15.3",
    "sass": "^1.67.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.2.2",
    "urql": "^4.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.27",
    "encoding": "^0.1.13",
    "openapi2aspida": "^0.24.0",
    "react-server-dom-webpack": "^19.2.7",
    "vinext": "^0.1.6",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
