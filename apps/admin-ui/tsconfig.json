{
  "extends": "../../tooling/tsconfig/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": "./src"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": [
		"node_modules",
		"node_modules.root-owned-backup-*",
		".next",
		"e2e",
		"playwright.config.ts",
		"vitest.config.ts",
		"vite.config.ts",
		"**/*.stories.ts",
		"**/*.stories.tsx"
	]
}
